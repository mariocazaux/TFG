{
  "name": "kachaoo-workspace",
  "version": "1.0.0",
  "private": true,
  "author": "Mario Cazaux",
  "workspaces": [
    "dev/frontend",
    "dev/backend"
  ],
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "skill:update": "npx skills update",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "skills": "^1.5.10",
    "@fission-ai/openspec": "^1.5.0"
  },
  "lint-staged": {
    "dev/frontend/**/*.{ts,js,html}": [
      "eslint -c dev/frontend/eslint.config.js --fix",
      "prettier --write"
    ],
    "dev/backend/**/*.{ts,js}": [
      "eslint -c dev/backend/eslint.config.js --fix",
      "prettier --write"
    ],
    "dev/frontend/**/*.{scss,css}": [
      "stylelint --config dev/frontend/.stylelintrc.json --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
